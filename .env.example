# Copy this file to .env and fill in values. .env is gitignored.

# Local Postgres (matches docker-compose.yml). Used by goose (migrations) and the Go server.
DATABASE_URL=postgres://golink:golink@127.0.0.1:5433/golink?sslmode=disable

# Anthropic API key from https://console.anthropic.com/  (needed in Phase 7 frontend)
ANTHROPIC_API_KEY=

# Public URL of the deployed MCP server (set in Phase 6 after Railway deploy)
MCP_SERVER_URL=

# Shared secret the frontend sends and the MCP server checks (set in Phase 8)
MCP_AUTH_TOKEN=
